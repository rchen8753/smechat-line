# ── App ──
# Public base URL (used for LINE webhook URLs and Stripe redirects). Use your ngrok URL when testing locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key for encrypting LINE credentials at rest: `openssl rand -base64 32`
ENCRYPTION_KEY=

# ── LLM (Claude for replies) ──
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# ── Embeddings (OpenAI text-embedding-3-small, 1536 dims) ──
OPENAI_API_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly price for the Pro plan (e.g. NT$1,990 / month), created in the Stripe dashboard
STRIPE_PRICE_ID_PRO=

# ── Email (handoff notifications via Resend). Optional: without it, notifications are only logged. ──
RESEND_API_KEY=
EMAIL_FROM="AI 客服通知 <notify@yourdomain.com>"
